# Local development only. Copy to .env and change passwords.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=tu_coffee
MYSQL_USER=coffee
MYSQL_PASSWORD=change-me-local-app
MYSQL_ROOT_PASSWORD=change-me-local-root
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
# Base64 of at least 32 random bytes. Generate with scripts/initialize-local-env.ps1.
AUTH_JWT_SECRET=
# HTTPS deployments must use Secure cookies and explicit trusted origins.
AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080
