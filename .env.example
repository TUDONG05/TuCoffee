# MySQL installed on the local machine. Use the existing database credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tu_coffee
MYSQL_USER=coffee
MYSQL_PASSWORD=change-me-local-app
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
# Base64 of at least 32 random bytes. Generate with scripts/initialize-local-env.ps1.
AUTH_JWT_SECRET=
# OAuth Web application Client ID (public). No client secret needed for Google ID-token sign-in.
GOOGLE_CLIENT_ID=
# HTTPS deployments must use Secure cookies and explicit trusted origins.
AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# Cloudflare Turnstile: set real keys and enable, then restart backend.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Payment / Bank Transfer (VietQR)
BANK_CODE=VCB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=TU COFFEE

# SePay Webhook Authentication (Optional - set if configured on my.sepay.vn)
SEPAY_API_KEY=

# Payment / VNPAY Gateway (Sandbox)
VNPAY_TMN_CODE=DEMOV210
VNPAY_HASH_SECRET=DEMOHASHSECRET210
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4200/orders/vnpay-return

# Password recovery: blank SMTP host disables delivery (no OTP logging).
# PASSWORD_RESET_SECRET=use-a-separate-random-secret-of-at-least-32-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Private RAG storage. Relative paths resolve from the backend process.
RAG_STORAGE_ROOT=./data/knowledge
RAG_WORKER_ENABLED=false
RAG_EMBEDDING_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=0
RAG_EMBEDDING_TIMEOUT_SECONDS=15
RAG_POLL_DELAY_MS=3000

# Chat can read indexed knowledge even when the ingestion worker is disabled.
RAG_CHAT_ENABLED=false
RAG_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
RAG_CHAT_MODEL=gemini-3.1-flash-lite
# RAG_CHAT_API_KEY=uses-RAG_EMBEDDING_API_KEY-when-omitted
RAG_CHAT_TIMEOUT_SECONDS=20
RAG_CHAT_MIN_SIMILARITY=0.55
RAG_CHAT_REQUESTS_PER_IP_MINUTE=10
RAG_CHAT_REQUESTS_PER_USER_MINUTE=10
RAG_CHAT_DAILY_LIMIT=500
RAG_CHAT_MAX_CONCURRENT_PER_IDENTITY=2
RAG_CHAT_MAX_CONCURRENT=20
# Opt in only when the backend accepts traffic from the configured reverse proxy,
# which must overwrite X-Real-IP using the actual client address.
RAG_CHAT_TRUSTED_PROXY_IP=
