# MySQL installed on the local machine. Use the existing database credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tu_coffee
MYSQL_USER=coffee
MYSQL_PASSWORD=change-me-local-app
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
# Base64 of at least 32 random bytes. Generate with scripts/initialize-local-env.ps1.
AUTH_JWT_SECRET=
# OAuth Web application Client ID (public). No client secret needed for Google ID-token sign-in.
GOOGLE_CLIENT_ID=
# HTTPS deployments must use Secure cookies and explicit trusted origins.
AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# Cloudflare Turnstile: set real keys and enable, then restart backend.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Payment / Bank Transfer (VietQR)
BANK_CODE=VCB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=TU COFFEE

# SePay Webhook Authentication (Optional - set if configured on my.sepay.vn)
SEPAY_API_KEY=

# Payment / VNPAY Gateway (Sandbox)
VNPAY_TMN_CODE=DEMOV210
VNPAY_HASH_SECRET=DEMOHASHSECRET210
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4200/orders/vnpay-return
